# Copia este archivo como ".env.properties" (misma carpeta) y ajusta los valores.
# ".env.properties" está en .gitignore — nunca subas credenciales reales al repo.
# Spring lo carga automáticamente (spring.config.import en application-dev.properties).

# --- Base de datos ---
# Si usas el docker-compose incluido (docker compose up -d), estos valores ya funcionan tal cual.
DB_URL=jdbc:mysql://localhost:3306/meowtfit
DB_USER=root
DB_PASS=root

# --- CORS / Frontend ---
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Almacenamiento de archivos (comprobantes de pago e imágenes de producto) ---
# Por defecto (AWS_S3_ENABLED=false) los archivos se guardan en ./uploads — no requiere AWS.
AWS_S3_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_S3_BUCKET=meowtfit-imagenes

# --- Correo (recuperación de contraseña) ---
# Por defecto (MAIL_ENABLED=false) los correos NO se envían de verdad: quedan
# registrados en la consola del backend para que copies el enlace mientras pruebas.
# Para enviar correos reales, pon MAIL_ENABLED=true y usa una contraseña de aplicación
# de Gmail (https://myaccount.google.com/apppasswords), no tu contraseña normal.
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
